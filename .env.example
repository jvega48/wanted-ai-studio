# ============================================================
# Wanted AI Studio — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/wanted_ai_studio"

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TTS_VOICE=alloy

# --- Twitch ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL_NAME=

# --- YouTube ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# --- Kick ---
KICK_CHANNEL_ID=
KICK_PUSHER_APP_KEY=

# --- Discord ---
DISCORD_WEBHOOK_URL=
DISCORD_CLIP_WEBHOOK_URL=

# --- OBS WebSocket ---
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=

# --- FFmpeg ---
# Defaults to system PATH; set this if ffmpeg is not in PATH
FFMPEG_PATH=
FFPROBE_PATH=

# --- Clips ---
CLIPS_OUTPUT_DIR=./data/clips
CLIPS_SOURCE_DIR=./data/recordings
CLIPS_MIN_TRIGGER_SCORE=0.65
CLIPS_MAX_DURATION=120
CLIPS_MIN_DURATION=15

# --- Dashboard ---
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=ws://localhost:3001/ws/events

# --- Security ---
JWT_SECRET=change_me_in_production_use_a_long_random_string
API_KEY_SALT=change_me_in_production

# --- Rate Limits ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
