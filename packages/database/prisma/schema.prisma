generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Stream Sessions ─────────────────────────────────────────────────────────

model StreamSession {
  id              String          @id @default(cuid())
  title           String
  description     String          @default("")
  status          StreamStatus    @default(OFFLINE)
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  viewerPeak      Int             @default(0)
  viewerAverage   Float           @default(0)
  chatMessages    Int             @default(0)
  newFollowers    Int             @default(0)
  newSubscribers  Int             @default(0)
  donations       Int             @default(0)
  donationAmount  Float           @default(0)
  clipCount       Int             @default(0)
  duration        Int             @default(0)
  tags            String[]
  gameTitle       String?
  thumbnailUrl    String?
  platforms       StreamPlatform[]
  vodUrls         Json            @default("{}")
  metadata        Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  clips           Clip[]
  chatLogs        ChatLog[]
  metrics         StreamMetricSnapshot[]
  moments         StreamMoment[]

  @@index([status])
  @@index([startedAt])
}

enum StreamStatus {
  OFFLINE
  STARTING
  LIVE
  ENDING
  ERROR
}

enum StreamPlatform {
  TWITCH
  YOUTUBE
  KICK
  TIKTOK
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatLog {
  id              String          @id @default(cuid())
  sessionId       String
  platform        StreamPlatform
  userId          String
  username        String
  displayName     String
  message         String
  badges          String[]
  color           String?
  isSubscriber    Boolean         @default(false)
  isModerator     Boolean         @default(false)
  isBroadcaster   Boolean         @default(false)
  isHighlighted   Boolean         @default(false)
  bits            Int?
  deleted         Boolean         @default(false)
  deletedReason   String?
  sentiment       Float?
  toxicityScore   Float?
  timestamp       DateTime

  session         StreamSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
  @@index([timestamp])
  @@index([platform])
}

// ─── Clips ────────────────────────────────────────────────────────────────────

model Clip {
  id              String          @id @default(cuid())
  sessionId       String
  timestampSeconds Float
  durationSeconds Float
  triggerType     String
  triggerScore    Float
  title           String?
  description     String?
  status          ClipStatus      @default(PENDING)
  sourcePath      String?
  outputPath      String?
  thumbnailPath   String?
  viewerCountAtTime Int?
  chatRateAtTime  Float?
  platforms       Json            @default("{}")
  format          ClipFormat      @default(LANDSCAPE)
  tags            String[]
  aiGenerated     Boolean         @default(true)
  manuallyApproved Boolean        @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  session         StreamSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([triggerScore])
}

enum ClipStatus {
  PENDING
  APPROVED
  PROCESSING
  READY
  PUBLISHED
  UPLOADED
  FAILED
  REJECTED
}

enum ClipFormat {
  LANDSCAPE
  PORTRAIT
  SQUARE
}

// ─── Analytics ────────────────────────────────────────────────────────────────

model StreamMetricSnapshot {
  id          String         @id @default(cuid())
  sessionId   String
  timestamp   DateTime
  totalViewers Int           @default(0)
  viewers     Json           @default("[]")
  chatRate    Float          @default(0)
  followRate  Float          @default(0)
  clipRate    Float          @default(0)
  bitrate     Float          @default(0)
  droppedFrames Int          @default(0)
  cpuUsage    Float          @default(0)
  gpuUsage    Float          @default(0)
  ramUsageMb  Float          @default(0)

  session     StreamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

model StreamMoment {
  id          String        @id @default(cuid())
  sessionId   String
  timestamp   Float
  type        String
  description String
  intensity   Float
  viewerCount Int?
  metadata    Json          @default("{}")
  createdAt   DateTime      @default(now())

  session     StreamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([type])
}

// ─── Memory ───────────────────────────────────────────────────────────────────

model MemoryEntry {
  id            String      @id @default(cuid())
  type          MemoryType
  scope         MemoryScope
  key           String
  content       String
  tags          String[]
  importance    Float       @default(0.5)
  accessCount   Int         @default(0)
  lastAccessedAt DateTime   @default(now())
  expiresAt     DateTime?
  sourceAgentId String?
  sessionId     String?
  metadata      Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([type, scope])
  @@index([key])
  @@index([tags])
  @@index([expiresAt])
}

enum MemoryType {
  SHORT_TERM
  LONG_TERM
  EPISODIC
  SEMANTIC
  PROCEDURAL
}

enum MemoryScope {
  SESSION
  STREAM
  CREATOR
  VIEWER
  GLOBAL
}

// ─── Creator Profile ──────────────────────────────────────────────────────────

model CreatorProfile {
  id            String    @id @default(cuid())
  name          String
  brand         String
  niche         String[]
  targetAudience String
  tone          String    @default("energetic")
  keyPhrases    String[]
  goals         String[]
  schedule      Json      @default("{}")
  totalRevenue  Float     @default(0)
  totalStreams  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sponsors      Sponsor[]
  platforms     PlatformProfile[]
}

model Sponsor {
  id            String         @id @default(cuid())
  profileId     String
  name          String
  contactEmail  String?
  dealValue     Float?
  notes         String?
  activeSince   DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  profile       CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PlatformProfile {
  id              String         @id @default(cuid())
  profileId       String
  platform        StreamPlatform
  channelName     String
  followers       Int            @default(0)
  subscribers     Int            @default(0)
  averageViewers  Float          @default(0)
  totalViews      BigInt         @default(0)
  updatedAt       DateTime       @updatedAt

  profile         CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, platform])
}

// ─── Content Queue ────────────────────────────────────────────────────────────

model ContentQueueItem {
  id          String              @id @default(cuid())
  type        ContentType
  platform    StreamPlatform
  title       String?
  description String?
  tags        String[]
  thumbnailPath String?
  filePath    String?
  status       ContentQueueStatus  @default(PENDING)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  sourceClipId String?
  platformUrl  String?
  errorMessage String?
  retryCount   Int                 @default(0)
  metadata     Json                @default("{}")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([platform])
  @@index([type])
}

enum ContentType {
  LONG_VIDEO
  SHORT
  TIKTOK
  CLIP
  THUMBNAIL
  POST
}

enum ContentQueueStatus {
  PENDING
  APPROVED
  SCHEDULED
  UPLOADING
  PUBLISHED
  FAILED
  REJECTED
  CANCELLED
}

// ─── Agent Tasks ──────────────────────────────────────────────────────────────

model AgentTask {
  id          String      @id @default(cuid())
  agentId     String
  type        String
  priority    String      @default("normal")
  payload     Json
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  result      Json?
  error       String?
  retryCount  Int         @default(0)
  maxRetries  Int         @default(3)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now())

  @@index([agentId])
  @@index([scheduledAt])
  @@index([completedAt])
}

// ─── Plugin Registry ──────────────────────────────────────────────────────────

model Plugin {
  id          String        @id @default(cuid())
  name        String        @unique
  displayName String
  version     String
  description String
  author      String
  enabled     Boolean       @default(true)
  config      Json          @default("{}")
  permissions String[]
  installedAt DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  actor       String
  resource    String
  resourceId  String?
  before      Json?
  after       Json?
  ipAddress   String?
  userAgent   String?
  success     Boolean   @default(true)
  error       String?
  timestamp   DateTime  @default(now())

  @@index([action])
  @@index([actor])
  @@index([timestamp])
}
