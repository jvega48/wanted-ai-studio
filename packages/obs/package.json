{
  "name": "@wanted/obs",
  "version": "1.0.0",
  "private": true,
  "description": "OBS WebSocket client for Wanted AI Studio",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wanted/shared": "workspace:*",
    "obs-websocket-js": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
