    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wanted/shared": "workspace:*",
    "openai": "^4.56.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
